  "queryDefaults": {
    "customerOrders": 20,
    "merchantOrders": 50,
    "deliveryQueue": 50,
    "drivers": 50,
    "supportCases": 50,
    "merchants": 50,
    "audit": 100,
    "adminOrders": 50,
    "merchantApplications": 50,
    "driverApplications": 50,
    "promotions": 50,
    "waitlist": 50
  },
  "retention": {
    "driverLocationMinutes": 30,
    "telemetryDays": 30,
